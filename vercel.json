{
  "version": 2,
  "name": "muju-website",
  "alias": ["muju-website"],
  "env": [],
  "buildCommand": "echo 'Static site, no build needed'",
  "builds": [
    {
      "src": "muju.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/muju.html",
      "status": 200
    },
    {
      "src": "/photo/(.*)",
      "dest": "/photo/$1"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/photo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/webp"
        }
      ]
    },
    {
      "source": "/**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/muju.html",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
